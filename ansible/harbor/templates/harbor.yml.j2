# Harbor 2.9 hivatalos sablon
hostname: "{{ harbor_hostname }}"

http:
  port: {{ harbor_http_port }}

# https:
#   port: 443
#   certificate: /your/certificate/path
#   private_key: /your/private/key/path

harbor_admin_password: "{{ harbor_admin_password }}"

database:
  password: "{{ harbor_db_password }}"
  max_idle_conns: 50
  max_open_conns: 100

data_volume: /data

trivy:
  ignore_unfixed: false
  skip_update: false
  offline_scan: false
  security_checkers: vuln

jobservice:
  max_job_workers: 10
  job_loggers:
    - file
  logger_sweeper_duration: 14

notification:
  webhook_job_max_retry: 3

chart:
  absolute_url: disabled

log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: /var/log/harbor

metric:
  enabled: true
  port: {{ harbor_metric_port }}
  path: /metrics